# Strava API (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:3001/api/strava/callback

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
NOTIFICATION_PHONE_NUMBER=+1234567890

# Anthropic (agentic SMS conversations)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Notification timing
NOTIFICATION_HOUR=20
NOTIFICATION_TIMEZONE=America/Denver
